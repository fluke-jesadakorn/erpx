# World ERP web-admin local configuration (placeholders — copy to .env.local)
POSTGRES_USER=contract
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_DB=finance_db
POSTGRES_PORT=5432

# Service URLs (HTTP, same host)
RBAC_SVC_URL=http://localhost:3100
AI_SVC_URL=http://localhost:3004

# Session (minted here, verified by rbac-svc and ai-svc)
SESSION_SECRET=generate_with_openssl_rand_hex_32
DEV_ACTOR_PIN=optional_pin_for_dev_persona_switch

# Single-source key for pgcrypto ai_encrypt/ai_decrypt on AI provider API keys.
# Must match the value used when `db/seed_ai_settings.js` was run.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32