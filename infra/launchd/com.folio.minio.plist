<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.folio.minio</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/minio/bin/minio</string>
        <string>server</string>
        <string>--address=:9000</string>
        <string>--console-address=:9001</string>
        <string>/Users/fluke/folio-minio-data</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MINIO_ROOT_USER</key>
        <string>minioadmin</string>
        <key>MINIO_ROOT_PASSWORD</key>
        <string>minioadmin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/fluke/folio-minio.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/fluke/folio-minio.err.log</string>
</dict>
</plist>
