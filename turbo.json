{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "ERPX_NODE_BIN",
    "ERPX_BUN_BIN"
  ],
  "tasks": {
    "typecheck": {
      "outputs": [
        ".cache/typecheck.tsbuildinfo"
      ]
    },
    "lint": {
      "outputs": []
    },
    "build": {
      "outputs": [
        ".next/**",
        "!.next/dev/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "cacheDir": ".turbo/cache"
}
