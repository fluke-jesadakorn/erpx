# Copy to .env.local for development; keep actual credentials out of Git.
# Production is installed at /Library/Application Support/ERPX/config/production.env.
ERPX_ENVIRONMENT=local
# Canonical application/authentication origin. Generated links use this host.
ERPX_PUBLIC_ORIGIN=https://console-dev-erpx.jesadakorn.com
# Public homepage served by the same environment service.
ERPX_MARKETING_ORIGIN=https://dev-erpx.jesadakorn.com
ERPX_FRONT_PMS_ORIGIN=https://dev-pms.jesadakorn.com
ERPX_FRONT_POS_ORIGIN=https://dev-pos.jesadakorn.com
BETTER_AUTH_SECRET=generate-at-least-32-random-bytes
# Absolute paths; native runtime never reads a manifest from the release itself.
ERPX_DATA_DIR=/absolute/path/to/erpx/.runtime/local
ERPX_DATABASE_MANIFEST=/absolute/path/to/erpx/.runtime/local/config/databases.json
# Provision/migrate only. Do not give this administrator URL to the web service.
ERPX_ADMIN_DATABASE_URL=postgresql://erpx_dev_admin:replace-password@127.0.0.1:5432/postgres
ERPX_DATABASE_PREFIX=erpx_dev
# Shared local cluster with a prefix-guarded, non-superuser test administrator.
ERPX_TEST_ADMIN_URL=postgresql://erpx_test_admin:replace-password@127.0.0.1:5432/postgres

ERPX_PUBLIC_BETA=false
ERPX_ADMIN_EMAIL=jesadakorn.kirtnu@gmail.com
BETA_MEMBER_LIMIT=20
BETA_BRANCH_LIMIT=5
BETA_AI_LIMIT=100
BETA_STORAGE_BYTES=1073741824
RESEND_FROM="ERPX <no-reply@notify.jesadakorn.com>"
RESEND_API_KEY=
# Web Push stays disabled until all four values are configured on app and jobs.
# Generate one VAPID key pair once; keep the private and data keys outside Git.
# A separate subscription is required for each browser origin (Console/POS/PMS).
ERPX_PUSH_VAPID_PUBLIC_KEY=
ERPX_PUSH_VAPID_PRIVATE_KEY=
ERPX_PUSH_VAPID_SUBJECT=mailto:push@example.com
ERPX_PUSH_DATA_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_CREDENTIAL_KEY_ID=v1
AI_CREDENTIAL_KEYS=
# Public beta has no live payment collection. Only sandbox Stripe is supported.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Opt in only after enabling PromptPay on the Stripe test account.
ERPX_BILLING_PROMPTPAY_SANDBOX=false

# Company Connect: shared by POS and PMS, separate from ERPX subscription billing.
POS_STRIPE_TEST_SECRET_KEY=
POS_STRIPE_TEST_WEBHOOK_SECRET=
POS_STRIPE_TEST_CLIENT_ID=
POS_STRIPE_LIVE_SECRET_KEY=
POS_STRIPE_LIVE_WEBHOOK_SECRET=
POS_STRIPE_LIVE_CLIENT_ID=
# Enable only after sandbox acceptance and company onboarding.
POS_STRIPE_LIVE_ENABLED=false
# Public booking always requires a ready connected account; set false only to
# disable the public booking routes during rollout.
PMS_STRIPE_BOOKING_ENABLED=true
PMS_STRIPE_LIVE_ENABLED=false
# Keep production restaurant room charges disabled until the pilot's linked
# correction, reconciliation, multi-role browser, and business gates pass.
ERPX_POS_ROOM_CHARGE_PILOT_ENABLED=false

# Native dev Redis only; production remains PostgreSQL-only. Never commit credentials.
ERPX_WORK_CACHE=off
ERPX_REDIS_URL=
ERPX_DEV_PG_POOL_MAX=6
ERPX_PERF_LOG=0

# The global gate controls the v2 UI/API surface. Compatibility intake still
# uses the fail-closed scanner, so these paths are required before deployment.
# The socket and signature directory must be absolute and shared by web/jobs.
ERPX_ATTACHMENTS_V2=false
# Emergency rollback only: leave V2 false and set this true to keep clean,
# immutable bound evidence readable while user attachment commands are blocked.
ERPX_ATTACHMENTS_READ_ONLY=false
ERPX_ATTACHMENT_UPLOAD_FREEZE=false
ERPX_CLAMAV_VERSION=1.5.4
ERPX_CLAMD_SOCKET=/opt/homebrew/var/run/clamav/clamd.sock
ERPX_CLAMAV_DATABASE_DIR=/opt/homebrew/var/lib/clamav
# Operator verification reads these configs; the application itself connects
# only to the Unix socket and never opens a ClamAV TCP port.
ERPX_CLAMD_CONF=/absolute/path/to/clamd.conf
ERPX_FRESHCLAM_CONF=/absolute/path/to/freshclam.conf
ERPX_CLAMAV_MAX_DEFINITION_AGE_MS=86400000
# Optional lower fail-closed deadlines for constrained/test hosts; production
# defaults are 5 seconds for commands and 30 seconds for bounded scans.
ERPX_CLAMD_COMMAND_TIMEOUT_MS=5000
ERPX_CLAMD_SCAN_TIMEOUT_MS=30000
ERPX_HEIF_CONVERT=/opt/homebrew/opt/libheif/bin/heif-convert
ERPX_PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm

# Legal document processing (run bun scripts/legal/setup.ts on the runtime host).
# For standalone releases, use absolute paths outside the release directory.
# ERPX_LEGAL_PYTHON=/absolute/persistent/legal-python/bin/python
# ERPX_TESSDATA_DIR=/absolute/persistent/legal-ocr/tessdata
# ERPX_OCR_LANGUAGES=eng+tha
# ERPX_TESSERACT_BIN=/opt/homebrew/bin/tesseract
# ERPX_PDFTOTEXT_BIN=/opt/homebrew/bin/pdftotext
# ERPX_PDFINFO_BIN=/opt/homebrew/bin/pdfinfo
# ERPX_PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm

# Optional: connect to an existing MinIO instance and a dedicated ERPX bucket.
# The application scopes object keys by environment. Existing local files remain readable.
# Include MinIO objects in each environment's backup before retiring local originals.
ERPX_MINIO_ENDPOINT=
ERPX_MINIO_BUCKET=
ERPX_MINIO_ACCESS_KEY=
ERPX_MINIO_SECRET_KEY=
ERPX_MINIO_REGION=us-east-1
