# World ERP web-admin local configuration (placeholders — copy to .env.local)
POSTGRES_USER=contract
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_DB=finance_db
POSTGRES_PORT=5432

# Service URLs (HTTP, same host)
RBAC_SVC_URL=http://localhost:3100
AI_SVC_URL=http://localhost:3004

# Session (minted here, verified by rbac-svc and ai-svc)
SESSION_SECRET=generate_with_openssl_rand_hex_32
DEV_ACTOR_PIN=optional_pin_for_dev_persona_switch
FOLIO_WORKER_TOKEN=generate_with_openssl_rand_hex_32
FOLIO_BOOTSTRAP_TOKEN=generate_with_openssl_rand_hex_32

# ERPX control plane. Keep write and read stores physically separate in
# deployed environments; local development may omit the read URL to use the
# Folio database as a temporary projection fallback.
ERPX_CONTROL_WRITE_DATABASE_URL=postgres://contract:change_me@localhost:5432/erpx_control_write?sslmode=verify-full
ERPX_CONTROL_READ_DATABASE_URL=postgres://contract:change_me@localhost:5432/erpx_control_read?sslmode=verify-full
# Local development only; never enable in production. ERPX control reads fail
# closed unless the isolated control-read URL is configured.
# ERPX_LOCAL_BREAK_GLASS_READ=false
ERPX_SUPPORT_APPROVAL_SECRET=generate_with_openssl_rand_hex_32
ERPX_ACCESS_TOKEN_SIGNING_KEY=generate_with_openssl_rand_hex_32_or_longer
# Signed, short-lived step-up evidence from the deployed MFA authority. The
# platform fails closed for high-risk role operations when this is absent.
ERPX_PLATFORM_STEP_UP_SECRET=generate_with_openssl_rand_hex_32
# Keep false until the ERPX control-write store and bridge acceptance checks are
# approved; Folio remains the command owner while this is false.
# ERPX_BRIDGE_SHADOW_WRITES=false
ERPX_STRIPE_WEBHOOK_SECRET=whsec_replace_with_a_32_byte_secret
# Callback verifier resolution: env is host-native pilot composition. For the
# production HTTP gateway, set this to http and configure the HTTPS endpoint;
# manager references are never sent to an untrusted URL.
ERPX_MARKETING_CALLBACK_SECRET_RESOLVER=env
# ERPX_MARKETING_SECRET_MANAGER_URL=https://secrets.internal.example
# ERPX_MARKETING_SECRET_MANAGER_TOKEN=inject_at_runtime
# ERPX_MARKETING_SECRET_MANAGER_TIMEOUT_SECONDS=5
# Provider delivery is account-bound; reconciliation is optional per channel
# and must query provider idempotency state without resubmitting a dispatch.
# ERPX_MARKETING_PROVIDER_KEY=provider-account-key
# ERPX_MARKETING_PROVIDER_EMAIL_URL=https://provider.example/send
# ERPX_MARKETING_PROVIDER_EMAIL_RECONCILE_URL=https://provider.example/reconcile
ERPX_GRPC_ADDR=127.0.0.1:50051

# ERPX directory feed worker. The worker refuses to claim imports until a
# real TLS-validating LDAP/AD DS/UCS adapter and connector are configured.
# Supported adapters: ldap_polling, ad_dirsync, rfc4533,
# ucs_provisioning_service. Credential values stay in the secret manager.
# ERPX_DIRECTORY_CONNECTOR_ID=00000000-0000-0000-0000-000000000000
# ERPX_DIRECTORY_FEED_ADAPTER=rfc4533
# Live directory execution is fail-closed: bind credentials and the connector
# endpoint are required; no anonymous/plaintext/local fallback is supported.
# ERPX_DIRECTORY_BIND_DN=CN=erpx-sync,OU=Service Accounts,DC=example,DC=test
# ERPX_DIRECTORY_PASSWORD=resolve-from-secret-manager
# ERPX_DIRECTORY_PAGE_SIZE=5000
# ERPX_DIRECTORY_FULL_IMPORT=false
# ERPX_DIRECTORY_FILTER=(objectClass=person)
# ERPX_DIRECTORY_IMMUTABLE_ATTRIBUTE=entryUUID
# ERPX_DIRECTORY_LOGIN_ATTRIBUTE=uid
# ERPX_UCS_SUBSCRIPTION=erpx-sync
# ERPX_UCS_SUBSCRIPTION_PASSWORD=resolve-from-secret-manager

# G13 Folio source bridge. The source URL must use PostgreSQL TLS
# (sslmode=require, verify-ca, or verify-full). The bridge only performs a
# read-only aggregate extraction, records bounded source evidence, and queues
# backfill scopes; it never changes Folio ownership or writes tenant data.
# ERPX_WORKER_HANDLER=g13_folio_bridge
# ERPX_G13_SOURCE_DATABASE_URL=postgresql://folio_bridge@folio.example/folio_db?sslmode=verify-full
# ERPX_G13_RUN_ID=00000000-0000-0000-0000-000000000000
# ERPX_G13_COHORT=holding-cohort-2026-07
# ERPX_G13_ID_NAMESPACE=folio-g13-2026-07
# ERPX_G13_BRIDGE_ACTOR_REF=local:g13-folio-bridge
# ERPX_G13_BRIDGE_MFA_VERIFIED=true
# ERPX_G13_BRIDGE_BREAK_GLASS=false
# ERPX_G13_TARGET_DATABASE_URL=postgresql://erpx_target@erpx.example/tenant_db?sslmode=verify-full
# ERPX_G13_TARGET_READ_DATABASE_URL=postgresql://erpx_target_read@erpx.example/tenant_read_db?sslmode=verify-full
# ERPX_G13_ROLLBACK_DATABASE_URL=postgresql://erpx_rollback@erpx.example/rollback_db?sslmode=verify-full
# ERPX_G13_TARGET_HOLDING_REF=holding-001
# ERPX_G13_TARGET_ACTOR_REF=local:g13-target-worker
# ERPX_G13_TARGET_MFA_VERIFIED=true
# ERPX_G13_ROLLBACK_WRITES_BLOCKED=false

# Single-source key for pgcrypto ai_encrypt/ai_decrypt on AI provider API keys.
# Must match the value used when `db/seed_ai_settings.js` was run.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# Optional MiniMax LLM (IT can assign it later; it is not the default).
MINIMAX_API_KEY=sk-cp-replace_me
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3

# OpenRouter free-model default (runtime prefers the encrypted provider row).
OPENROUTER_API_KEY=sk-or-v1-replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:3004
OPENROUTER_TITLE=Folio
