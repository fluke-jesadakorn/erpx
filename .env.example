# Copy to .env.local for development; keep actual credentials out of Git.
# Production is installed at /Library/Application Support/ERPX/config/production.env.
ERPX_ENVIRONMENT=local
# Legacy Console origin. Registry-backed Apps/Account/product origins own new links
# when development product routing and SSO are enabled.
ERPX_PUBLIC_ORIGIN=https://console-dev-erpx.jesadakorn.com
# Public homepage served by the same environment service.
ERPX_MARKETING_ORIGIN=https://dev-erpx.jesadakorn.com
ERPX_FRONT_PMS_ORIGIN=https://dev-pms.jesadakorn.com
ERPX_FRONT_POS_ORIGIN=https://dev-pos.jesadakorn.com
BETTER_AUTH_SECRET=generate-at-least-32-random-bytes
# Absolute paths; native runtime never reads a manifest from the release itself.
ERPX_DATA_DIR=/absolute/path/to/erpx/.runtime/local
ERPX_DATABASE_MANIFEST=/absolute/path/to/erpx/.runtime/local/config/databases.json
# Provision/migrate only. Do not give this administrator URL to the web service.
ERPX_ADMIN_DATABASE_URL=postgresql://erpx_dev_admin:replace-password@127.0.0.1:5432/postgres
ERPX_DATABASE_PREFIX=erpx_dev
# Shared local cluster with a prefix-guarded, non-superuser test administrator.
ERPX_TEST_ADMIN_URL=postgresql://erpx_test_admin:replace-password@127.0.0.1:5432/postgres

ERPX_PUBLIC_BETA=false
ERPX_ADMIN_EMAIL=jesadakorn.kirtnu@gmail.com
BETA_MEMBER_LIMIT=20
BETA_BRANCH_LIMIT=5
BETA_AI_LIMIT=100
BETA_STORAGE_BYTES=1073741824
RESEND_FROM="ERPX <no-reply@notify.jesadakorn.com>"
RESEND_API_KEY=
# Web Push stays disabled until all four values are configured on app and jobs.
# Generate one VAPID key pair once; keep the private and data keys outside Git.
# A separate subscription is required for each browser origin (Console/POS/PMS).
ERPX_PUSH_VAPID_PUBLIC_KEY=
ERPX_PUSH_VAPID_PRIVATE_KEY=
ERPX_PUSH_VAPID_SUBJECT=mailto:push@example.com
ERPX_PUSH_DATA_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_CREDENTIAL_KEY_ID=v1
AI_CREDENTIAL_KEYS=
# Public beta has no live payment collection. Only sandbox Stripe is supported.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Opt in only after enabling PromptPay on the Stripe test account.
ERPX_BILLING_PROMPTPAY_SANDBOX=false

# Company Connect: shared by POS and PMS, separate from ERPX subscription billing.
POS_STRIPE_TEST_SECRET_KEY=
POS_STRIPE_TEST_WEBHOOK_SECRET=
POS_STRIPE_TEST_CLIENT_ID=
POS_STRIPE_LIVE_SECRET_KEY=
POS_STRIPE_LIVE_WEBHOOK_SECRET=
POS_STRIPE_LIVE_CLIENT_ID=
# Enable only after sandbox acceptance and company onboarding.
POS_STRIPE_LIVE_ENABLED=false
# Set false to disable public booking routes during rollout. Pay-at-hotel
# needs no Connect account; prepaid rates require a ready Company connection.
# Sandbox stays available in release builds; live collection has a separate gate.
PMS_STRIPE_BOOKING_ENABLED=true
PMS_STRIPE_LIVE_ENABLED=false
# Keep production restaurant room charges disabled until the pilot's linked
# correction, reconciliation, multi-role browser, and business gates pass.
ERPX_POS_ROOM_CHARGE_PILOT_ENABLED=false

# Native dev Redis only; production remains PostgreSQL-only. Never commit credentials.
ERPX_WORK_CACHE=off
ERPX_REDIS_URL=
# Per non-Control binding in development; Control and jobs use separate budgets.
ERPX_DEV_PG_POOL_MAX=3
# Per non-Control binding in compiled web releases (1–16). Keep the default
# until measuring the shared server connection budget; PMS scale rehearsal uses 4.
ERPX_APP_PG_POOL_MAX=1
# Control connections per web runtime pool (1–16); jobs remain at 2. Measure the shared
# PostgreSQL connection budget before changing the conservative default.
ERPX_CONTROL_PG_POOL_MAX=5
ERPX_PERF_LOG=0

# The global gate controls the v2 UI/API surface. Compatibility intake still
# uses the fail-closed scanner, so these paths are required before deployment.
# The socket and signature directory must be absolute and shared by web/jobs.
ERPX_ATTACHMENTS_V2=false
# Emergency rollback only: leave V2 false and set this true to keep clean,
# immutable bound evidence readable while user attachment commands are blocked.
ERPX_ATTACHMENTS_READ_ONLY=false
ERPX_ATTACHMENT_UPLOAD_FREEZE=false
ERPX_CLAMAV_VERSION=1.5.4
ERPX_CLAMD_SOCKET=/opt/homebrew/var/run/clamav/clamd.sock
ERPX_CLAMAV_DATABASE_DIR=/opt/homebrew/var/lib/clamav
# Operator verification reads these configs; the application itself connects
# only to the Unix socket and never opens a ClamAV TCP port.
ERPX_CLAMD_CONF=/absolute/path/to/clamd.conf
ERPX_FRESHCLAM_CONF=/absolute/path/to/freshclam.conf
ERPX_CLAMAV_MAX_DEFINITION_AGE_MS=86400000
# Optional lower fail-closed deadlines for constrained/test hosts; production
# defaults are 5 seconds for commands and 30 seconds for bounded scans.
ERPX_CLAMD_COMMAND_TIMEOUT_MS=5000
ERPX_CLAMD_SCAN_TIMEOUT_MS=30000
ERPX_HEIF_CONVERT=/opt/homebrew/opt/libheif/bin/heif-convert
ERPX_PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm

# Legal document processing. The Rust verifier is the only PDF production
# runtime; Python under tests/support/legal/pdf-oracle is a development oracle.
# For standalone releases, use absolute paths outside the release directory.
# Install erpx-validate-pdf beside the configured supervisor binary.
# ERPX_LEGAL_PDF_VERIFIER_BIN=/absolute/persistent/erpx/bin/erpx-verify-pdf
# ERPX_TESSDATA_DIR=/absolute/persistent/legal-ocr/tessdata
# ERPX_OCR_LANGUAGES=eng+tha
# ERPX_TESSERACT_BIN=/opt/homebrew/bin/tesseract
# ERPX_PDFTOTEXT_BIN=/opt/homebrew/bin/pdftotext
# ERPX_PDFINFO_BIN=/opt/homebrew/bin/pdfinfo
# ERPX_PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm

# Optional: connect to an existing MinIO instance and a dedicated ERPX bucket.
# The application scopes object keys by environment. Existing local files remain readable.
# Include MinIO objects in each environment's backup before retiring local originals.
ERPX_MINIO_ENDPOINT=
ERPX_MINIO_BUCKET=
ERPX_MINIO_ACCESS_KEY=
ERPX_MINIO_SECRET_KEY=
ERPX_MINIO_REGION=us-east-1

# Coordinated Finance presentation release/rollback. Company AI policy still defaults off.
ERPX_FINANCE_WORKSPACE_V2=0

# Product separation is not accepted for cutover. Keep disabled until the owner
# command/job/package, browser and DNS/TLS acceptance in production-plan.md pass.
# Future erpx.com origins are never trusted by these flags.
# Exact Holding hosts in packages/contracts/src/holding-hosts.ts; development only.
ERPX_HOLDING_ROUTING=disabled
ERPX_PRODUCT_ENVIRONMENT=development
ERPX_PRODUCT_ROUTING=disabled
ERPX_PRODUCT_SSO=disabled
# Set only after complete current-candidate migration/Commercial/workflow acceptance.
# Development Console then returns 410 for every path/method except health/ready.
# Routing/SSO outages do not reopen it. Explicit rollback restores this to disabled.
ERPX_CONSOLE_RETIRED=disabled

# Work-owned tasks, calendar and collaboration only; shared owner actions keep
# their product authority. Enable after complete Work and legacy parity acceptance.
ERPX_APPS_PACKAGE_ENFORCEMENT=disabled

# Development Helpdesk purchase gate. Keep disabled until Company parity is accepted.
# shadow records scoped decisions; enforced denies commands. Routing and SSO are independent.
ERPX_SUPPORT_PACKAGE_ENFORCEMENT=disabled

# Field Service uses native enforced purchase decisions in the Rust candidate.
# Configure the explicit native Field transports below; there is no TS rollout flag.

# Development-only POS package review; keep disabled until every POS surface and Company parity is accepted.
ERPX_POS_PACKAGE_ENFORCEMENT=disabled

# Development-only Hotel command review; other PMS surfaces/owner obligations remain required.
ERPX_PMS_PACKAGE_ENFORCEMENT=disabled

# Development-only Finance review; keep disabled until all Finance surfaces, handoffs and legacy parity pass.
ERPX_FINANCE_PACKAGE_ENFORCEMENT=disabled
# Development-only People Roster/Payroll owner boundaries; keep disabled until
# complete cross-surface and legacy Company parity acceptance. No grant enables it.
ERPX_PEOPLE_PACKAGE_ENFORCEMENT=disabled
# Development-only Sales/Supply Commerce owner boundaries; shared references keep
# their original owners. Complete source coverage and parity precede enforcement.
ERPX_COMMERCE_PACKAGE_ENFORCEMENT=disabled
# Projects owner purchase checks; enable only after current legacy parity and acceptance.
ERPX_PROJECTS_PACKAGE_ENFORCEMENT=disabled
# Independent development-only owner switches; never implied by a grant or host.
ERPX_ASSETS_PACKAGE_ENFORCEMENT=disabled
ERPX_LEARNING_PACKAGE_ENFORCEMENT=disabled
ERPX_MANUFACTURING_PACKAGE_ENFORCEMENT=disabled
ERPX_TALENT_PACKAGE_ENFORCEMENT=disabled
ERPX_LEGAL_PACKAGE_ENFORCEMENT=disabled

# Optional per-machine lazy app process cap (1-12); repository default is 4.
# ERPX_DEV_MAX_APPS=6

# Explicit native development flow only; leave unset for the existing runtime.
# ERPX_NATIVE_ACCOUNT_SESSION_CONFIG is private JSON: privateBaseUrl,
# accountOrigin, holdingOrigins[], timeoutMs. Use only the same leased case.
# ERPX_NATIVE_FINANCE_JOURNAL_CONFIG is private JSON: privateBaseUrl,
# holdings[{origin,holdingSlug,holdingId}], timeoutMs. Failures never fall back.
# ERPX_NATIVE_FINANCE_SERVICE_INVOICE_CONFIG is mandatory for native invoice reads:
# privateBaseUrl, holdings[{origin,holdingSlug,holdingId}], timeoutMs.
# Rust observes persisted ownership before SSR/REST detail; only a successful
# non-Field verdict selects the retained reader. Errors never fall back.
# The leased runtime separately needs financeFieldServiceInvoiceReads.
# ERPX_NATIVE_FINANCE_SERVICE_INVOICE_POST_CONFIG uses the journal read-config
# shape (no invoice ID list). It is mandatory for invoice-post dispatch in the
# native candidate: Rust observes actual Company invoice ownership first.
# Only an explicit legacy verdict keeps non-Field posting; errors never fallback.
# The leased runtime separately needs financeFieldServiceInvoicePosts, a subset
# of financeFieldServiceInvoiceReads; reads alone never enable writes.
# ERPX_NATIVE_FINANCE_SERVICE_PAYMENT_CONFIG uses the same journal read shape.
# The native candidate requires this for payment detail: Rust observes persisted
# payment ownership, then supplies the Field-origin workspace/current context.
# Only an explicit legacy verdict keeps the non-Field reader; errors close.
# The leased runtime separately needs financeFieldServiceReceiptWrites.
# ERPX_NATIVE_FINANCE_JOURNAL_POST_CONFIG separately enables native posting.
# Foreign Field Service cost posting additionally requires the explicit private
# financeFieldServiceJournalPosts target; current staff/Flow gates still apply.
# ERPX_NATIVE_FINANCE_JOURNAL_REVERSE_CONFIG independently enables native reversal
# and its two native readbacks; posting configuration is not required.
# Command configs use the read-config shape and require their respective
# explicit native runtime action target.
# ERPX_NATIVE_FINANCE_JOURNAL_CREATE_CONFIG independently enables manual creation
# and its native draft readback. It does not enable editing or other commands.

# ERPX_NATIVE_FINANCE_JOURNAL_EDIT_CONFIG independently enables strict manual
# draft edits and their native edition/workspace readback; other flags do not.

# ERPX_NATIVE_FIELD_SERVICE_WORK_CONFIG selects the native Field Service Work
# source and its owner-verified Workflow filtering in nonproduction; requires
# the matching private fieldServiceWorkReads Holding target.

# ERPX_NATIVE_FIELD_SERVICE_DETAIL_CONFIG selects native scoped Service order detail;
# configured failures never fall back to the retained owner.

# ERPX_NATIVE_FIELD_SERVICE_WORKSPACE_CONFIG selects the native scoped Service
# workspace read; configured failures never fall back to the retained owner.
# Shape matches the private owner read configs and requires fieldServiceWorkspaceReads.

# ERPX_NATIVE_FIELD_SERVICE_PARTS_SETUP_CONFIG selects only mapping GET and
# initialize/root POST + confirm-existing POST for exact configured Holdings.
# Private JSON: privateBaseUrl (owned loopback HTTP), timeoutMs (250..30000),
# holdings: [{origin:"https://acme.jesadakorn.com",holdingSlug:"acme",holdingId:"h001"}].
# Requires matching private fieldServicePartsPostingSetups and normal Account context.
# ERPX_NATIVE_FIELD_SERVICE_PREREQUISITES_CONFIG independently selects native
# prerequisite discovery and chart/account/period/manual-rate commands. It uses
# the same exact-origin/Holding/loopback shape and timeout bounds as mapping.
# Requires private fieldServicePartsPrerequisites plus fieldServiceReads for
# that Holding. Default off; selected failures never use a retained writer.
# ERPX_NATIVE_FIELD_SERVICE_STOCK_SETUP_CONFIG independently selects native
# Stock setup discovery and product/warehouse master commands, with the same
# exact-origin/Holding/loopback shape. Requires private fieldServiceStockSetups.
# Normal inventory.read + inventory.prepare and Company/Branch context apply.
# Physical initial-count routes remain retained and are not selected by this flag.
# Selected transport never falls back on denial/outage/malformed response.
# Prerequisites and Stock masters have independent native selectors; physical
# initial counts remain explicitly owned by the transitional backend.
# ERPX_NATIVE_FIELD_SERVICE_RESERVE_CONFIG selects the exact private reserve
# transport and native reservation readback; shape matches the owner read configs.

# ERPX_NATIVE_FIELD_SERVICE_ISSUE_CONFIG independently selects native Issue Part
# and Service-owned receipt/event/reservation/stock confirmation. Finance journal
# reads keep their own configuration and permissions; not required to issue.

# ERPX_NATIVE_FIELD_SERVICE_REQUEST_CONFIG independently selects native Request
# creation and receipt-bound Service/Support confirmation; no configured fallback.

# ERPX_NATIVE_FIELD_SERVICE_ORDER_CREATE_CONFIG selects native creation from an
# existing Support ticket; this does not create, claim, or update that ticket.

# ERPX_NATIVE_FIELD_SERVICE_VISIT_CONFIG independently selects native Schedule,
# Dispatch and Start with keyed visit confirmation. Its private runtime requires
# an explicit fieldServiceVisits Holding target and corresponding fieldServiceReads.

# ERPX_NATIVE_FIELD_SERVICE_VISIT_COMPLETION_CONFIG independently selects native
# Complete visit and key-bound Service event confirmation; no configured fallback.

# ERPX_NATIVE_FIELD_SERVICE_VISIT_RECOVERY_CONFIG independently selects native
# Exception and Resume with key-bound Service visit confirmation.

# ERPX_NATIVE_FIELD_SERVICE_CANCEL_CONFIG independently selects native Service
# order cancellation and key-bound Service visit confirmation.

# ERPX_NATIVE_FIELD_SERVICE_AGREEMENT_REVIEW_CONFIG independently selects native
# Activate, Reject and Retire with keyed Agreement event confirmation.

# ERPX_NATIVE_FIELD_SERVICE_AGREEMENT_CREATE_CONFIG independently selects native
# Agreement draft creation and keyed Service/Finance Money confirmation.

# ERPX_NATIVE_FIELD_SERVICE_BILLING_CONFIG independently selects native Service
# billing release and keyed Service evidence; Finance access remains separate.

# ERPX_NATIVE_FIELD_ATTACHMENT_CONFIG selects exact development Field visit link
# IDs for native withdrawal/status only. The private owner proves the real target.
# Unlisted Files families retain their existing route; configured failures close.

# ERPX_NATIVE_ATTACHMENT_READ_CONFIG selects native Company-scoped attachment set
# and link-status metadata reads. Unset retains the TypeScript reader; a
# configured invalid or failed read never falls back. Example:
# ERPX_NATIVE_ATTACHMENT_READ_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# ERPX_NATIVE_FIELD_SERVICE_INITIAL_COUNT_CONFIG independently selects native
# Service initial Count reads/create/actions/Flow, with the same exact-origin,
# Holding and private-loopback shape. Default off; selected failures never fall
# back. Private fieldServiceInitialCounts entries require holdingId and explicit
# filesEnabled/filesReadOnly/uploadsFrozen booleans, plus fieldServiceReads.
# The Count source, actor, purchase, Flow and owner transaction guards still apply.
# This development opt-in is not a legacy writer fence or a production release.

# Support command routes are native-only. The five selectors are independent:
# unset, malformed or unavailable configuration closes POST with 503
# NATIVE_SUPPORT_*_UNAVAILABLE; no retained TypeScript writer is selected.
# Shape: privateBaseUrl (owned loopback HTTP), timeoutMs (250..30000),
# holdings:[{origin:"https://acme.jesadakorn.com",holdingSlug:"acme",holdingId:"h001"}].
# The private development/production document separately needs the matching
# supportTicketWrites, supportSlaWrites, supportIncidentWrites,
# supportSessionWrites or supportEvidenceWrites entries
# ({holdingId,companyId}); a selector without its private target returns 404.
# ERPX_NATIVE_SUPPORT_TICKET_CONFIG selects create/triage/start/resolve/confirm/
# reopen/cancel/reassign/report commands. Bind/revoke evidence uses the separate
# evidence selector below, so the ticket selector does not enable file changes.
# ERPX_NATIVE_SUPPORT_EVIDENCE_CONFIG selects bind-evidence/revoke-evidence.
# ERPX_NATIVE_SUPPORT_SLA_CONFIG selects policy, approved-target, acknowledge and
# ticket-clock commands; the native support-sla-drain job uses the private target.
# ERPX_NATIVE_SUPPORT_INCIDENT_CONFIG selects incident create/change/link commands.
# ERPX_NATIVE_SUPPORT_SESSION_CONFIG selects session request/review/capability commands.
# Normal GET/SSR owner reads remain on the current TypeScript read adapters until
# their native read migration; these selectors do not change that surface.

# Brand identity is available through the native owner when this selector is
# set. The private document must also list the Holding/Company under
# financeJournalReads so the native Brand router is mounted for that target.
# Shape: privateBaseUrl (owned loopback HTTP), timeoutMs (250..30000),
# holdings:[{origin:"https://acme.jesadakorn.com",holdingSlug:"acme",holdingId:"h001"}].
# Unset keeps the retained TypeScript read/write path. Malformed configuration
# or a failed native request never falls back to the TypeScript writer.
# ERPX_NATIVE_BRAND_IDENTITY_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native physical Assets is opt-in through the same exact-origin/Holding/loopback
# shape. The private document must list the Holding/Company under
# financeJournalReads so the native Assets router is mounted for that target.
# Unset keeps the retained TypeScript asset reader/writer. Malformed
# configuration or a failed native request never falls back to TypeScript.
# ERPX_NATIVE_ASSETS_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Finance bank import/reconciliation is opt-in. The private document
# must also list the Holding/Company under financeJournalReads. Shape matches
# ERPX_NATIVE_FINANCE_SERVICE_PAYMENT_CONFIG; unset retains the TypeScript path,
# and a configured native failure never falls back.
# ERPX_NATIVE_FINANCE_BANK_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native standalone supplier bills (payables) are opt-in through the same
# exact-origin/Holding/private-loopback shape. The private document must also
# list the Holding/Company under financeJournalReads. Covers standalone payable
# create/edit/post and payable detail; unset retains the TypeScript invoice path,
# and a configured native failure never falls back.
# ERPX_NATIVE_FINANCE_SUPPLIER_BILL_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Company Finance period close is opt-in through the same exact-origin/
# Holding/private-loopback shape. The private document must also list the
# Holding/Company under financeJournalReads. Covers close workspace, readiness,
# begin/cancel/approve/reopen and reconciliation readback; unset retains the
# TypeScript close path, and a configured native failure never falls back.
# ERPX_NATIVE_FINANCE_PERIOD_CLOSE_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Support workspace/detail reads are opt-in. The private document must
# also list the Holding/Company under supportTicketWrites. Shape matches the
# Support command selectors; unset retains the TypeScript reads.
# ERPX_NATIVE_SUPPORT_READ_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}
# ERPX_NATIVE_ORGANIZATION_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}
# ERPX_NATIVE_INVENTORY_STOCK_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}
# Native Sales quotation and sales-order document list read is opt-in through
# the same exact-origin/Holding/private-loopback shape. Unset retains the
# TypeScript Commerce list reader; a configured native failure never falls
# back. Purchase admission remains a preflight here and must be repeated in the
# composition backend's serializable owner transaction.
# ERPX_NATIVE_SALES_DOCUMENTS_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Sales price-list draft create/update and independent activate/cancel
# are opt-in through the same private-loopback/Holding shape. Unset retains the
# TypeScript pricing commands; once configured, an invalid or failed native
# command never falls back. Quotation/order draft write, sales approval and
# confirmed sales cancellation remain on their owning Commerce/Finance/
# Inventory paths.
# ERPX_NATIVE_SALES_PRICING_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native CRM lead/opportunity pipeline list is opt-in through the same exact
# private-loopback and Holding shape. Unset retains the TypeScript CRM
# workspace reader; once configured, an invalid or failed native read never
# falls back. CRM commands and lead detail remain retained.
# ERPX_NATIVE_CRM_PIPELINE_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Marketing campaign ledger and lead-capture attribution report is
# opt-in through the same exact private-loopback and Holding shape. Unset
# retains the TypeScript marketingWorkspace campaign/attribution read; once
# configured, an invalid or failed native read never falls back. Campaign
# commands, assets, public forms and CRM handoff remain retained.
# ERPX_NATIVE_MARKETING_CAMPAIGN_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}
# ERPX_NATIVE_MARKETING_LEAD_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Customer 360 federated timeline is opt-in through the same exact
# private-loopback and Holding shape. Unset retains the TypeScript customer
# timeline; once configured, an invalid or failed native read never falls back.
# Customer notes, portal and customer-authority commands remain retained.
# ERPX_NATIVE_CUSTOMER_TIMELINE_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}
# Native Customer Authority customer-access workspace/detail and source-bound
# request/approve/reject/revoke commands are opt-in through the same exact
# private-loopback and Holding shape. Unset retains the TypeScript reader and
# commands; once configured, an invalid or failed native read/command never
# falls back. Invitations, portal support, identity changes and duplicate
# review remain retained.
# ERPX_NATIVE_CUSTOMER_ACCESS_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}
# ERPX_NATIVE_LEARNING_CONFIG; unset retains the TypeScript Learning reader and commands.
# ERPX_NATIVE_LEARNING_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}
# Native Talent requisition workspace rows and draft/approve/reject/open/close/
# cancel commands are opt-in through the same exact private-loopback and Holding
# shape. Unset retains the TypeScript reader and commands; once configured, an
# invalid or failed native read/command never falls back. Candidate, application,
# proposal, offer, hire-handoff and privacy workflows remain retained.
# ERPX_NATIVE_TALENT_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Ecommerce channel/listing storefront catalog is opt-in through the
# same exact private-loopback and Holding shape. Unset retains the TypeScript
# Ecommerce workspace list read; once configured, an invalid or failed native
# read never falls back. Cart, checkout, fulfillment, return and listing-create
# commands remain retained.
# ERPX_NATIVE_ECOMMERCE_CATALOG_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Planning workspace scenario/recommendation/resource read is opt-in
# through the same exact private-loopback and Holding shape. Unset retains the
# TypeScript Planning lists; once configured, a failed native read never falls
# back. Planning calculate/cancel/release commands remain retained.
# ERPX_NATIVE_PLANNING_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Platform Administration is opt-in through the same exact-origin,
# Platform Holding and private-loopback shape. The private document must list
# the ERPX Holding `h003` with slug `erpx`. Unset or malformed configuration
# fails closed with 503 and never falls back to the retained TypeScript page.
# The selector covers the operations/provisioning read, Holding provisioning
# and dead-letter recovery.
# ERPX_NATIVE_PLATFORM_ADMIN_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://erpx-internal.jesadakorn.com","holdingSlug":"erpx","holdingId":"h003"}]}
# Native Commercial Company package overview is opt-in through the same
# exact-origin private-loopback shape. Unset or malformed configuration fails
# closed with 503 NATIVE_COMMERCIAL_UNAVAILABLE and never falls back to the
# retained TypeScript companyPackageLifecycle reader.
# ERPX_NATIVE_COMMERCIAL_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://erpx-internal.jesadakorn.com","holdingSlug":"erpx","holdingId":"h003"}]}

# Native PMS room-board reads are opt-in through the same private-loopback,
# exact-Holding shape. Unset or malformed configuration fails the Rooms and
# Housekeeping pages/API closed with 503 NATIVE_PMS_UNAVAILABLE; it never falls
# back to the retained TypeScript pmsWorkspace reader for those sections.
# ERPX_NATIVE_PMS_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Agent evidence reads are opt-in through the same private-loopback,
# exact-Holding shape. Unset or malformed configuration renders invocation and
# private-session evidence as unavailable and never falls back to the retained
# TypeScript agentWorkspace invocation/session collections. Agent lifecycle and
# session hold/release/expire commands remain retained.
# ERPX_NATIVE_AGENT_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Benefits enrollment workspace reads are opt-in through the same
# private-loopback, exact-Holding shape. Unset retains the TypeScript
# benefitsWorkspace reader; once configured, an invalid or failed native read
# never falls back to it. Plan/window/dependent/election commands, detail
# history/payroll, attachments and package settlement remain retained.
# ERPX_NATIVE_BENEFITS_CONFIG={"privateBaseUrl":"http://127.0.0.1:44997","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Commerce quotation/sales-order document reads and safe lifecycle
# transitions are opt-in through the same private-loopback, exact-Holding shape.
# Unset retains getOrder/transitionOrder. Once configured, an invalid or failed
# native read/command never falls back. Sales approval, confirmed sales-order
# cancellation, fulfillment, invoicing, returns and purchase orders remain
# retained.
# ERPX_NATIVE_COMMERCE_ORDER_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Identity Access assignment rows and withdrawal are opt-in through the
# same private-loopback, exact-Holding shape. Unset retains the TypeScript
# iamOverview assignment query and revokeIamAssignment; once configured, an
# invalid or failed native read/command never falls back. Role proposal,
# access-review decisions, Directory, MFA, invitations and identity conflicts
# remain retained.
# ERPX_NATIVE_IDENTITY_ACCESS_CONFIG={"privateBaseUrl":"http://127.0.0.1:44998","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}

# Native Collaboration Handbook reads are opt-in through the same exact-origin/
# Holding/private-loopback shape. Unset retains the TypeScript handbook reader;
# once configured, an invalid or failed native read never falls back. Social,
# messaging, teams/channels, attachments and inbox presentation remain retained.
# ERPX_NATIVE_HANDBOOK_CONFIG={"privateBaseUrl":"http://127.0.0.1:44993","timeoutMs":5000,"holdings":[{"origin":"https://acme.jesadakorn.com","holdingSlug":"acme","holdingId":"h001"}]}
