# Next.js local env (see src/app/). Copy to .env.local
# Example: DATABASE_URL for Prisma/Drizzle (TBD), NEXTAUTH_SECRET, etc.
# DATABASE_URL=postgresql://user:pass@localhost:5432/erpx?sslmode=disable
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=change_me

# ── Deprecated — Rust/Dioxus era (archived 2026-09-02, keep for reference on backup/rust-2026-09-02) ──
# Local development database used only by the bounded cutover reset.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=contract
POSTGRES_PASSWORD=change_me
POSTGRES_DB=folio_db

# Exact host-native object-store target. The reset rejects non-loopback
# endpoints, symlinked buckets, broad roots, and unknown bucket names.
ERPX_DEV_LEGACY_MINIO_ENDPOINT=http://127.0.0.1:9000
ERPX_DEV_LEGACY_MINIO_ROOT=/absolute/path/to/local/minio-data

# `cargo xtask dev --detach` derives the four isolated ERPX database URLs,
# generates stable local signing/encryption keys under .runtime/erpx, and sets:
# ERPX_DIRECTORY_RUNTIME=disabled
# ERPX_DEVELOPMENT_PROFILE=local
#
# Optional dev-only browser access through Tailscale Serve HTTPS. Use the
# machine's exact MagicDNS FQDN without a scheme, port, path, or wildcard.
# ERPX_DEV_PERSONA_MODE=enabled
# ERPX_DEV_TAILSCALE_FQDN=machine-name.tailnet-name.ts.net
#
# Local controller authorization is disabled unless all four values below are
# set exactly and the debug/local/loopback/local-ucs-lab gates also pass.
# ERPX_DEV_CONTROLLER_ROLE_PROFILE=restricted_tenant_full_admin
# ERPX_DEV_CONTROLLER_TARGET_TENANT=demo-tenant-restricted
# ERPX_DEV_CONTROLLER_MFA_BYPASS=enabled
# ERPX_DEV_CONTROLLER_SOD_BYPASS=enabled
#
# Wave 9 projection workers are incremental by default. A Customer 360
# rebuild requires a new UUID generation; activation remains checkpoint/DLQ
# guarded and never falls back to a write database.
# ERPX_CUSTOMER360_PROJECTION_MODE=incremental
# ERPX_CUSTOMER360_REBUILD_GENERATION=00000000-0000-0000-0000-000000000000
# ERPX_OPERATIONS_PROJECTION_PAGE_SIZE=500
#
# Operations source ingestion always checkpoints the closed typed source
# inventory. Automatic exception detection is fail-closed and disabled unless
# explicitly enabled. When enabled, all fields below are required and the
# assignee UUID must resolve through the current Identity manager chain.
# ERPX_OPERATIONS_DETECTION_ENABLED=false
# ERPX_OPERATIONS_DETECTION_ALLOWED_SOURCES=commercial,marketing,crm,procurement,inventory,assets,maintenance,quality,sales,people_payroll,pos,finance,support
# ERPX_OPERATIONS_DETECTION_POLICY_REF=operations-default-v1
# ERPX_OPERATIONS_DETECTION_ASSIGNEE_REF=00000000-0000-0000-0000-000000000000
# ERPX_OPERATIONS_DETECTION_CATEGORY=source_exception
# ERPX_OPERATIONS_DETECTION_SEVERITY=warning
# ERPX_OPERATIONS_DETECTION_DUE_MINUTES=60
# ERPX_OPERATIONS_DETECTION_ESCALATION_MINUTES=240
#
# One-shot fresh-state bootstrap. The profile credentials belong to the
# non-CREATEDB runtime role; the separate administrator creates four new
# databases with that runtime role as owner. The base URL contains no
# credentials. `check` and `bootstrap` also require the exact retained-resource
# inventory, a stopped old runtime, and the literal no-copy/no-merge fence.
# ERPX_DATABASE_PROFILE_DEFAULT_URL=postgresql://localhost:55432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/.runtime/erpx/infra/certificates/ca.crt
# ERPX_DATABASE_PROFILE_DEFAULT_USERNAME=erpx_app
# ERPX_DATABASE_PROFILE_DEFAULT_PASSWORD=read_from_private_secret_store
# ERPX_SETUP_DATABASE_ADMIN_USERNAME=erpx_admin
# ERPX_SETUP_DATABASE_ADMIN_PASSWORD=read_from_private_secret_store
# ERPX_SETUP_PREFIX=erpxv2
# ERPX_SETUP_TENANT_NAME=Primary Tenant
# ERPX_SETUP_HOLDING_NAME=Primary Holding
# ERPX_SETUP_ROOT_PRINCIPAL=local:platform-root-v2
# ERPX_SETUP_HOLDING_OWNER_PRINCIPAL=local:holding-owner-v2
# ERPX_SETUP_CUTOVER_CONFIRM=FRESH_STATE_NO_COPY_NO_MERGE
# ERPX_SETUP_OLD_RUNTIME_STATE=stopped
# ERPX_SETUP_WORKSPACE_ROOT=/absolute/path/to/erpx
# ERPX_SETUP_MINIO_ENDPOINT=https://127.0.0.1:9000
# ERPX_SETUP_MINIO_ACCESS_KEY=read_from_private_secret_store
# ERPX_SETUP_MINIO_SECRET_KEY=read_from_private_secret_store
# ERPX_SETUP_MINIO_REGION=us-east-1
# ERPX_SETUP_MINIO_CA_CERT_PATH=/absolute/path/to/.runtime/erpx/infra/certificates/ca.crt
# ERPX_SETUP_RETAINED_PREFIXES=erpx
# ERPX_SETUP_RETAINED_DATABASES=erpx_control_write,erpx_control_read,erpx_tenant_write,erpx_tenant_read
# ERPX_SETUP_RETAINED_OBJECT_NAMESPACES=erpx-demo,erpx-tenant-objects
# ERPX_SETUP_RETAINED_BINARY_RELEASES=pre-cqrs-v1
# ERPX_SETUP_RETAINED_ENVIRONMENT_REF=.runtime/erpx/cutover/source.env.local
#
# Successful bootstrap publishes a non-secret, write-once handoff at
# `.runtime/erpx/cutover/fresh-state.json`. `cargo xtask dev --detach` verifies
# its complete DB receipt, generation-v2 schema, generation-v3 service catalog,
# active registry row, and rollback policy before using the fresh control
# databases. It
# never seeds demo fixtures into a fresh-state runtime.
#
# Deployed non-loopback database, object-store, provider, and directory
# endpoints must use certificate-validating TLS. Do not put credentials here.
