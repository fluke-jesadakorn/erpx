# World ERP web-admin local configuration (placeholders — copy to .env.local)
POSTGRES_USER=contract
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_DB=finance_db
POSTGRES_PORT=5432

# Service URLs (HTTP, same host)
RBAC_SVC_URL=http://localhost:3100
AI_SVC_URL=http://localhost:3004

# Session (minted here, verified by rbac-svc and ai-svc)
SESSION_SECRET=generate_with_openssl_rand_hex_32
DEV_ACTOR_PIN=optional_pin_for_dev_persona_switch
FOLIO_WORKER_TOKEN=generate_with_openssl_rand_hex_32
FOLIO_BOOTSTRAP_TOKEN=generate_with_openssl_rand_hex_32

# Single-source key for pgcrypto ai_encrypt/ai_decrypt on AI provider API keys.
# Must match the value used when `db/seed_ai_settings.js` was run.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# Optional MiniMax LLM (IT can assign it later; it is not the default).
MINIMAX_API_KEY=sk-cp-replace_me
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3

# OpenRouter free-model default (runtime prefers the encrypted provider row).
OPENROUTER_API_KEY=sk-or-v1-replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:3004
OPENROUTER_TITLE=Folio
