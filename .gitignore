# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/public/vendor/pdfjs-*/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.dev.vars
.dev.vars.*
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# legacy Rust artifacts (retained on backup branch; ignored here)
.runtime/
.sqlx/
/target/
.cargo/

# local skill mirror — canonical is .agents/skills/ (see AGENTS.md, docs/TOC.md)
.claude/skills/

# wayfinder local tracker — archived to docs/archive/wayfinder-2026-09-02/
.scratch/
.tmp/

__pycache__/
