{
  "name": "ERPX Service Count development",
  "dockerComposeFile": [
    "../ops/containers/development-services.compose.yaml",
    "compose.yaml"
  ],
  "service": "workspace",
  "runServices": [
    "workspace",
    "postgres",
    "scanner",
    "mailbox",
    "https"
  ],
  "workspaceFolder": "/workspace/erpx",
  "shutdownAction": "none",
  "overrideCommand": false,
  "postCreateCommand": "scripts/local/dev-container bootstrap",
  "postStartCommand": "scripts/local/dev-container start",
  "initializeCommand": "scripts/local/dev-container populate"
}
