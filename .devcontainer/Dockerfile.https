FROM caddy:2.11.2-alpine@sha256:834468128c7696cec0ceea6172f7d692daf645ae51983ca76e39da54a97c570d
# The upstream binary's low-port file capability conflicts with cap_drop: ALL.
# This development proxy binds only the unprivileged port 3443.
RUN setcap -r /usr/bin/caddy
COPY Caddyfile /etc/caddy/Caddyfile
