{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

# A registered TLS SNI with an unknown HTTP Host must also fail explicitly.
https://:3443 {
	tls internal
	respond 421
}

https://account.erpx.localhost:3443, https://acme.erpx.localhost:3443, https://northstar.erpx.localhost:3443, https://erpx-internal.erpx.localhost:3443 {
	tls internal
	# Match the full authority: the TLS hostname alone does not isolate ports.
	@registered expression `{http.request.hostport} in ['account.erpx.localhost:3443', 'acme.erpx.localhost:3443', 'northstar.erpx.localhost:3443', 'erpx-internal.erpx.localhost:3443']`
	handle @registered {
		request_header -Forwarded
		request_header -X-Forwarded-*
		reverse_proxy 127.0.0.1:3100 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {http.request.hostport}
			header_up X-Forwarded-Port 3443
		}
	}
	respond 421
}
