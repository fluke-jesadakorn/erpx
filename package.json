{
  "name": "folio",
  "version": "1.0.0",
  "description": "Folio — flat Next.js 16 process on 3004. Domain logic in lib/ as @/*. Bundler: Turbopack only.",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3004 -H 0.0.0.0",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:setup": "bash db/setup.sh",
    "db:reset-local": "FOLIO_RESET_CONFIRM=RESET_FOLIO_LOCAL bash db/setup.sh --reset-local",
    "embed": "node db/embed_coa.js",
    "audit": "node db/audit_ai_coverage.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:list": "playwright test --list",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-tooltip": "^1.2.11",
    "axios": "^1.7.7",
    "csv-parse": "^7.0.1",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^1.24.0",
    "minio": "^8.0.7",
    "next": "16.2.9",
    "next-intl": "^4.13.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "sharp": "^0.34.4",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/minio": "^7.1.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
