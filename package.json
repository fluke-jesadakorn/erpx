    "ui:check-complete": "bun scripts/ui/coverage.mjs && bun scripts/ui/check-standard.mjs --complete",
    "test:unit": "bun scripts/testing/test.ts unit",
    "test:e2e": "bun scripts/testing/test.ts e2e",
    "test:journeys": "bun scripts/testing/test.ts journeys",
    "test:uat": "bun scripts/testing/test.ts uat",
    "test:provider": "bun scripts/testing/test.ts provider",
    "test:dev": "bun scripts/testing/test.ts dev",
    "test:impact": "bun scripts/testing/test.ts impact",
    "test:full": "bun scripts/testing/full.ts",
    "test:catalogue": "bun scripts/testing/test.ts --check",
    "architecture:check": "bun scripts/architecture/check.ts && bun scripts/architecture/check-guest-account-terminology.ts && bun run structure:check",
    "architecture:prune": "bun scripts/architecture/check.ts --prune",
    "terminology:check": "bun scripts/architecture/check-guest-account-terminology.ts",
    "structure:check": "bun scripts/testing/layout.ts",
