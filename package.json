    "seed:organization:verify": "bun --conditions=react-server scripts/seed/seed-acme-organization.ts --verify",
    "seed:staff-defaults:preview": "bun --conditions=react-server scripts/seed/seed-acme-staff-defaults.ts --preview",
    "seed:staff-defaults:acme": "bun --conditions=react-server scripts/seed/seed-acme-staff-defaults.ts --apply",
    "seed:staff-defaults:verify": "bun --conditions=react-server scripts/seed/seed-acme-staff-defaults.ts --verify",
