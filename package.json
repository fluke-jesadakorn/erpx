{
  "name": "erpx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/prepare-pdf-assets.ts && bun scripts/local/dev.ts",
    "build": "bun scripts/prepare-pdf-assets.ts && next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:migrate:local": "bun scripts/local/provision.ts --development",
    "db:seed:local": "bun run seed:local",
    "seed:local": "bun run db:migrate:local && bun scripts/seed-local.ts && bun scripts/repair-seed-identity.ts && bun scripts/seed-commerce.ts && bun scripts/seed-staff-work.ts",
    "seed:verify:local": "bun scripts/verify-seed-local.ts",
    "seed:organization:preview": "bun scripts/seed-acme-organization.ts",
    "seed:organization:acme": "bun scripts/seed-acme-organization.ts --apply",
    "seed:organization:verify": "bun scripts/seed-acme-organization.ts --verify",
    "test": "bun scripts/local/test.ts",
    "test:integration": "bun scripts/local/test.ts",
    "status:capabilities": "bun scripts/generate-capability-matrix.ts",
    "test:e2e:local": "playwright test",
    "test:e2e:dev": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/auth-smoke.spec.ts",
    "test:e2e:work": "playwright test tests/e2e/work-journeys.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:business:local": "bun scripts/verify-business-workflows.ts && bun scripts/verify-identity-workflows.ts && bun scripts/verify-ledger-payroll.ts && bun scripts/verify-expense-workflows.ts && bun scripts/verify-inventory-counts.ts && bun scripts/verify-inventory-transfers.ts",
    "test:staff:local": "playwright test tests/e2e/staff-work.spec.ts",
    "beta:eval:ai": "bun scripts/eval-social-ai.ts",
    "typecheck": "tsc --noEmit",
    "preview": "bun run deploy:build",
    "deploy:build": "bun scripts/prepare-pdf-assets.ts && bun scripts/local/build-release.ts",
    "deploy:provision": "bun scripts/local/provision.ts",
    "deploy:doctor": "bun scripts/local/doctor.ts",
    "deploy:bootstrap-admin": "bun scripts/local/bootstrap-admin.ts",
    "dev:jobs": "bun scripts/local/dev-jobs.ts",
    "seed:roster:local": "bun --conditions=react-server scripts/seed-people-roster.ts",
    "seed:retirement:local": "bun --conditions=react-server scripts/seed-people-retirement.ts"
  },
  "packageManager": "bun@1.2.17",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "better-auth": "1.7.2",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.12",
    "ldapts": "9.0.0",
    "lucide-react": "1.41.0",
    "mammoth": "^1.12.3",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.1",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@cloudflare/workers-types": "5.20260905.1",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "1.4.1",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": "24.20.0",
    "bun": "1.2.17"
  }
}
