{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".scratch/dev/types/tools.tsbuildinfo",
    "types": [
      "node",
      "bun"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "src/workers/**/*.ts",
    "src/server/runtime/env.ts",
    "next.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".scratch",
    ".runtime",
    "apps",
    "docs"
  ]
}
