{
  "openapi": "3.1.0",
  "info": {
    "title": "ERPX native Finance records",
    "description": "Native Finance journal/invoice reads and Field no-charge confirmation on explicitly configured development targets. Reads require current finance.read/module and Commercial History. Confirmation additionally requires current finance.write/approve, independent invoice responsibility, same-unit Field proof and exact receipt/audit/outbox. Render context never grants authority. Contract export alone establishes no owner or production acceptance.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/holdings/{holding_slug}/finance/field-work": {
      "get": {
        "tags": [],
        "operationId": "get_field_work",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Source-qualified native Field invoice and spare-cost journal Work with the captured rendering context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceFieldWorkResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current Account session required"
          },
          "403": {
            "description": "Finance read denied"
          },
          "409": {
            "description": "Source or selected identity changed"
          }
        }
      }
    },
    "/api/v1/holdings/{holding_slug}/finance/invoices/{id}/confirm-no-charge": {
      "post": {
        "tags": [],
        "operationId": "confirm_service_no_charge",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceNoChargeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Exact independently confirmed Field zero-demand receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceNoChargeResponse"
                }
              }
            }
          },
          "403": {
            "description": "Current independent Finance reviewer required"
          },
          "409": {
            "description": "Source, context, responsibility or retained proof changed"
          }
        }
      }
    },
    "/api/v1/holdings/{holding_slug}/finance/invoices/{id}/workspace": {
      "get": {
        "tags": [],
        "operationId": "get_service_invoice_workspace",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "purpose",
            "in": "query",
            "description": "Optional payment-evidence admission: source-qualified Field receivables return PAYABLE_REQUIRED422; this never grants supplier-bill write authority",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current source-qualified Service invoice workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceServiceInvoiceWorkspaceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Finance read or purchase History denied"
          },
          "404": {
            "description": "Unavailable or unsupported source"
          },
          "422": {
            "description": "PAYABLE_REQUIRED for Field receivables requesting supplier-payment evidence"
          }
        }
      }
    },
    "/api/v1/holdings/{holding_slug}/finance/journals/{id}": {
      "get": {
        "tags": [],
        "operationId": "get_detail",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "description": "Exact registered Holding slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "Journal identity",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Journal detail and original render context from one retained authorization unit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceJournalReadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Finance read/purchase history denied"
          },
          "404": {
            "description": "Unavailable or unsupported source"
          },
          "409": {
            "description": "Supplied rendered context is stale"
          }
        }
      }
    },
    "/api/v1/holdings/{holding_slug}/finance/journals/{id}/flow": {
      "get": {
        "tags": [],
        "operationId": "get_field_journal_flow",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Source-verified native Field journal Flow or explicit non-Field legacy partition; rendered context from the same authorization unit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceFieldJournalFlowResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Finance source history denied"
          },
          "409": {
            "description": "Rendered context or source changed"
          }
        }
      },
      "post": {
        "tags": [],
        "operationId": "assign_field_journal_flow",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinanceFieldJournalFlowInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Exact native Field journal responsibility receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceFieldJournalFlowCommandResponse"
                }
              }
            }
          },
          "403": {
            "description": "Current Company administrator required"
          },
          "409": {
            "description": "Source, responsibility or rendered context changed"
          }
        }
      }
    },
    "/api/v1/holdings/{holding_slug}/finance/journals/{id}/workspace": {
      "get": {
        "tags": [],
        "operationId": "get_workspace",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact record workspace references and original render context from one retained unit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceJournalWorkspaceReadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Finance read/purchase History denied"
          },
          "404": {
            "description": "Unavailable or unsupported source"
          },
          "409": {
            "description": "Supplied rendered context is stale"
          }
        }
      }
    }
  },
