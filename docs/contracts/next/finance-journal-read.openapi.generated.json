{
  "openapi": "3.1.0",
  "info": {
    "title": "ERPX native Finance journal reads",
    "description": "Development-only unmounted detail and record-workspace component. Current finance.read/module and actual Commercial History remain required; no post/reviewer grant. First source scope admits proved Finance manual/opening/manual-root reversal records; missing foreign-owner/secondary-book facts deny. Render context is output data from the same retained authorization unit, never an input authority. No installed route/current page or release acceptance.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/holdings/{holding_slug}/finance/invoices/{id}/workspace": {
      "get": {
        "tags": [],
        "operationId": "get_service_invoice_workspace",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current source-qualified Service invoice workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceServiceInvoiceWorkspaceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Finance read or purchase History denied"
          },
          "404": {
            "description": "Unavailable or unsupported source"
          }
        }
      }
    },
    "/api/v1/holdings/{holding_slug}/finance/journals/{id}": {
      "get": {
        "tags": [],
        "operationId": "get_detail",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "description": "Exact registered Holding slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "Journal identity",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Journal detail and original render context from one retained authorization unit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceJournalReadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Finance read/purchase history denied"
          },
          "404": {
            "description": "Unavailable or unsupported source"
          },
          "409": {
            "description": "Supplied rendered context is stale"
          }
        }
      }
    },
    "/api/v1/holdings/{holding_slug}/finance/journals/{id}/workspace": {
      "get": {
        "tags": [],
        "operationId": "get_workspace",
        "parameters": [
          {
            "name": "holding_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact record workspace references and original render context from one retained unit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceJournalWorkspaceReadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Finance read/purchase History denied"
          },
          "404": {
            "description": "Unavailable or unsupported source"
          },
          "409": {
            "description": "Supplied rendered context is stale"
          }
        }
      }
    }
  },
  "components": {
