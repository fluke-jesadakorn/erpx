{
  "components": {
    "schemas": {
      "JournalEditResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ManualJournalEditResult"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "JournalLineInput": {
        "properties": {
          "accountId": {
            "type": "string"
          },
          "credit": {
            "type": "string"
          },
          "debit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dimensions": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "accountId",
          "debit",
          "credit"
        ],
        "type": "object"
      },
      "JournalStatus": {
        "enum": [
          "draft",
          "posted"
        ],
        "type": "string"
      },
      "ManualJournalEditInput": {
        "additionalProperties": false,
        "description": "Strict manual-draft edit input; chart and currency remain fixed.",
        "properties": {
          "chartId": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "entryDate": {
            "type": "string"
          },
          "expectedVersion": {
            "format": "int64",
            "maximum": 9007199254740990,
            "minimum": 1,
            "type": "integer"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/JournalLineInput"
            },
            "type": "array"
          },
          "memo": {
            "type": "string"
          },
          "periodId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "chartId",
          "periodId",
          "entryDate",
          "currency",
          "lines",
          "expectedVersion",
          "reason"
        ],
        "type": "object"
      },
      "ManualJournalEditResult": {
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "const": "draft",
            "type": "string"
          },
          "version": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": 2,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "status",
          "version"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "ERPX native Finance manual journal edit",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/holdings/{holding_slug}/finance/journals/{journal_id}/edit": {
      "post": {
        "operationId": "edit_journal",
        "parameters": [
          {
            "in": "path",
            "name": "holding_slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "journal_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualJournalEditInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalEditResponse"
                }
              }
            },
            "description": "Manual journal edit receipt"
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Current Finance authority denied"
          },
          "409": {
            "description": "Work context or command changed"
          }
        },
        "tags": []
      }
    }
  }
}
