{
  "components": {
    "schemas": {
      "JournalCreateResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PreparedJournalResult"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "JournalLineInput": {
        "properties": {
          "accountId": {
            "type": "string"
          },
          "credit": {
            "type": "string"
          },
          "debit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dimensions": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "accountId",
          "debit",
          "credit"
        ],
        "type": "object"
      },
      "JournalStatus": {
        "enum": [
          "draft",
          "posted"
        ],
        "type": "string"
      },
      "ManualJournalCreateInput": {
        "description": "Public browser request shape. The private manual-create ingress validates\nthe complete input then always chooses manual ownership and no source ID.",
        "properties": {
          "chartId": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "entryDate": {
            "type": "string"
          },
          "fxRate": {
            "type": "string"
          },
          "isOpening": {
            "type": "boolean"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/JournalLineInput"
            },
            "type": "array"
          },
          "memo": {
            "type": "string"
          },
          "periodId": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "sourceType": {
            "type": "string"
          }
        },
        "required": [
          "chartId",
          "periodId",
          "entryDate",
          "currency",
          "lines"
        ],
        "type": "object"
      },
      "PreparedJournalResult": {
        "properties": {
          "baseCurrency": {
            "type": "string"
          },
          "credit": {
            "type": "string"
          },
          "debit": {
            "type": "string"
          },
          "fxRateMicros": {
            "format": "int64",
            "maximum": 1000000000000,
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "status": {
            "const": "draft",
            "type": "string"
          },
          "version": {
            "const": 1,
            "maximum": 1,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "number",
          "status",
          "version",
          "debit",
          "credit",
          "fxRateMicros",
          "baseCurrency"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "ERPX native Finance manual journal creation",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/holdings/{holding_slug}/finance/journals": {
      "post": {
        "operationId": "create_journal",
        "parameters": [
          {
            "in": "path",
            "name": "holding_slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualJournalCreateInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalCreateResponse"
                }
              }
            },
            "description": "Original manual journal creation receipt"
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Current Finance authority denied"
          },
          "409": {
            "description": "Work context or command changed"
          }
        },
        "tags": []
      }
    }
  }
}
