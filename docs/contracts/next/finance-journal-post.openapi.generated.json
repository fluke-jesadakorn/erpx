    "title": "ERPX native Finance journal review",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/holdings/{holding_slug}/finance/journals/{id}/post": {
      "post": {
        "operationId": "post_journal",
        "parameters": [
          {
            "in": "path",
            "name": "holding_slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalPostInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalPostResponse"
                }
              }
            },
            "description": "Original journal posting receipt data"
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Current review authority denied"
          },
          "409": {
            "description": "Work or journal changed"
          }
        },
        "tags": []
      }
    },
