<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.erpx.shared-postgres</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/postgresql@18/bin/postgres</string>
    <string>-D</string>
    <string>/Users/fluke/.local/share/dev-infra/postgresql/18/data</string>
  </array>
  <key>UserName</key><string>fluke</string>
  <key>GroupName</key><string>staff</string>
  <key>WorkingDirectory</key><string>/Users/fluke/.local/share/dev-infra</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/fluke</string>
    <key>LANG</key><string>C</string>
    <key>LC_ALL</key><string>C</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/fluke/.local/share/dev-infra/logs/postgresql.log</string>
  <key>StandardErrorPath</key><string>/Users/fluke/.local/share/dev-infra/logs/postgresql.error.log</string>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
</dict>
</plist>
