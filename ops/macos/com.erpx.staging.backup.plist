<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.erpx.staging.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Library/Application Support/ERPX-Staging/ops/erpxctl.py</string>
    <string>--home</string>
    <string>/Library/Application Support/ERPX-Staging</string>
    <string>backup</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>45</integer></dict>
  <key>StandardOutPath</key><string>/Library/Application Support/ERPX-Staging/logs/backup-launcher.log</string>
  <key>StandardErrorPath</key><string>/Library/Application Support/ERPX-Staging/logs/backup-launcher.log</string>
</dict>
</plist>
