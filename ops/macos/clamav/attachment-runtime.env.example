# Runtime prerequisites. Installation is an operator action; ERPX never invokes Homebrew.
ERPX_CLAMAV_VERSION=1.5.4
ERPX_LIBHEIF_VERSION=1.23.5
ERPX_POPPLER_VERSION=26.09.0
ERPX_CLAMD_SOCKET=/Library/Application Support/ERPX-Attachments/run/clamd.sock
ERPX_CLAMAV_DATABASE_DIR=/Library/Application Support/ERPX-Attachments/db
ERPX_CLAMD_CONF=/Library/Application Support/ERPX-Attachments/clamd.conf
ERPX_FRESHCLAM_CONF=/Library/Application Support/ERPX-Attachments/freshclam.conf
ERPX_HEIF_CONVERT=/opt/homebrew/opt/libheif/bin/heif-convert
ERPX_PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm
